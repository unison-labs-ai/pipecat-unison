{
  "name": "pipecat-unison-demo",
  "version": "1.0.0",
  "description": "Persistent memory for Pipecat voice AI agents — powered by Unison.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "biome ci .",
    "setup:backend": "cd backend && python -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "dev:backend": "cd backend && source venv/bin/activate && python server.py",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "start:backend": "cd backend && python server.py",
    "start": "vite dev",
    "check": "biome ci ."
  },
  "keywords": [
    "pipecat",
    "unison",
    "memory",
    "voice",
    "ai",
    "agents"
  ],
  "author": "Unison Labs AI",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "^1.11.0",
    "@pipecat-ai/client-react": "^1.1.0",
    "@pipecat-ai/websocket-transport": "^1.6.7",
    "@unisonlabs/sdk": "^1.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
