# Required: Unison API token (starts with usk_live_...)
UNISON_TOKEN=usk_live_...

# Required: LLM API key — pick your provider
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional: Unison API base URL (defaults to https://api.unisonlabs.ai)
UNISON_API_URL=https://api.unisonlabs.ai

# Server config
PORT=8001
HOST=0.0.0.0

# Set to your frontend URL(s) in production
ALLOWED_ORIGINS=http://localhost:5173

# Set to your Railway/Fly.io host + "true" for SSL when deploying
# WS_HOST=your-app.railway.app
# USE_SSL=true
